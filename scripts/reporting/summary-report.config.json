    {
      "id": "feedback-dst-offset",
      "title": "DST-sensitive local offset handling",
      "description": "Meeting scheduling should use the local timezone offset for the parsed meeting date rather than today’s offset.",
      "evidence": [
        "dst-offset-test"
      ]
    },
    {
      "id": "feedback-deterministic-integration-tests",
      "title": "Deterministic integration coverage",
